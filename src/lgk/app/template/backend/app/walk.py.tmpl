"""The one walk this app serves. Generated by lakebase-graph-kit; regenerate, do not edit.

Every query reads the served schema only (`$served_schema`). The walk SQL is the kit's web
walk: depth $depth, at most $top_n nodes per hop, ties broken by node_id. Folded edges:
$folded; privacy floor: $privacy_floor (a neighbour below it is never served).
"""

SERVED_SCHEMA = $served_schema_repr
DEPTH = $depth
TOP_N = $top_n
PRIVACY_FLOOR = $privacy_floor
FOLDED = $folded

# Rows (hop, node_id, support, score); parameter %(start_node_id)s.
WALK_SQL = $walk_sql_repr

# The start node by natural key (and node type, when given).
RESOLVE_SQL = $resolve_sql_repr

# Labels and types of the walked nodes.
LABELS_SQL = $labels_sql_repr

# The set walk: {(seed key, stop key or None): SQL}, keys '<node_type>.<walk_key>' from
# the mapping's walk_keys; empty when the graph declares none (then there is no set-walk endpoint).
# Rows (hop, node_id, support, score, matched); parameters %(seed_value)s and, with a stop key,
# %(stop_value)s. Depth $depth, at most $top_n nodes per hop, at most $max_seeds seeds (more raise).
SET_WALK_SQL = $set_walk_sql_repr


class StartNotFound(LookupError):
    """No served node has this natural key (and type)."""


class AmbiguousStart(LookupError):
    """More than one served node has this natural key; pass its node type."""


class BadSetWalk(ValueError):
    """A seed or stop key the graph does not declare, or a stop key and stop value not given together."""


def resolve_start(conn, natural_key: str, node_type: str = None) -> dict:
    """The one served node with this natural key (and type)."""
    rows = conn.execute(RESOLVE_SQL, {"natural_key": natural_key, "node_type": node_type}).fetchall()
    if not rows:
        raise StartNotFound(f"no node with key {natural_key!r}" + (f" and type {node_type!r}" if node_type else ""))
    if len(rows) > 1:
        types = sorted(str(r[1]) for r in rows)
        raise AmbiguousStart(f"key {natural_key!r} names {len(rows)} nodes (types {types}); pass a type")
    node_id, kind = rows[0]
    return {"node_id": str(node_id), "node_type": kind, "natural_key": natural_key}


def _labelled(conn, walked) -> list:
    """Walked rows (hop, node_id, support, score[, matched]) with each node's type, key and label."""
    ids = [str(r[1]) for r in walked]
    labels = {str(r[0]): r[1:] for r in conn.execute(LABELS_SQL, {"node_ids": ids}).fetchall()} if ids else {}
    rows = []
    for hop, node_id, support, *_rest in walked:
        kind, key, label = labels.get(str(node_id), (None, None, None))
        rows.append({"hop": int(hop), "node_id": str(node_id), "node_type": kind,
                     "natural_key": key, "label": label, "support": int(support)})
    return rows


def run_walk(conn, natural_key: str, node_type: str = None) -> dict:
    """{"start": {...}, "rows": [{hop, node_id, node_type, natural_key, label, support}, ...]}.

    Rows keep the walk's order: by hop, then support (descending), then node_id.
    """
    start = resolve_start(conn, natural_key, node_type)
    walked = conn.execute(WALK_SQL, {"start_node_id": start["node_id"]}).fetchall()
    return {"start": start, "rows": _labelled(conn, walked)}


def set_walk_query(seed_key: str, stop_key: str = None, stop_value: str = None) -> str:
    """The baked set-walk SQL for this (seed key, stop key); BadSetWalk if the graph lacks it."""
    if stop_key is not None and stop_value is None:
        raise BadSetWalk(f"stop_key {stop_key!r} needs a stop_value")
    if stop_key is None and stop_value is not None:
        raise BadSetWalk("stop_value needs a stop_key (a stop value is never ignored)")
    sql = SET_WALK_SQL.get((seed_key, stop_key))
    if sql is None:
        keys = sorted({k for k, _ in SET_WALK_SQL})
        raise BadSetWalk(f"seed_key {seed_key!r} / stop_key {stop_key!r}: keys must be among {keys}")
    return sql


def run_set_walk(conn, seed_key: str, seed_value: str, stop_key: str = None, stop_value: str = None) -> dict:
    """{"seed", "stop", "rows": [{hop, node_id, node_type, natural_key, label, support, matched}]}.

    Hop 0 is every node with `seed_key` = `seed_value`; a reached node with `stop_key` =
    `stop_value` is returned with matched = true and is not walked past.
    """
    sql = set_walk_query(seed_key, stop_key, stop_value)
    params = {"seed_value": seed_value}
    if stop_key is not None:
        params["stop_value"] = stop_value
    walked = conn.execute(sql, params).fetchall()
    rows = _labelled(conn, walked)
    for row, r in zip(rows, walked):
        row["matched"] = bool(r[4])
    return {"seed": {"key": seed_key, "value": seed_value},
            "stop": None if stop_key is None else {"key": stop_key, "value": stop_value},
            "rows": rows}
